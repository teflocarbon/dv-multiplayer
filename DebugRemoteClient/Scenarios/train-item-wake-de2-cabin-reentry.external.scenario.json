{
  "testId": "external.train-item-wake-de2-cabin-reentry",
  "displayName": "Leave and re-enter moving DE2 cabin lab",
  "category": "Train Item Wake System",
  "fidelity": "CapturedTrainLocalLab+InterestRetirement+RemoteClientContinuity+Reprojection",
  "timeoutMilliseconds": 360000,
  "requiredCapabilities": [
    "host-train-fixtures",
    "train-item-wake-lab",
    "inventory-runtime-arrangement"
  ],
  "sourceProfile": "../Labs/de2-cabin-box-stack.lab.json",
  "steps": [
    {
      "id": "create-train",
      "command": "train.fixture-create",
      "target": "host",
      "parameters": {
        "fixtureId": "de2-cabin-lab-reentry-${run.id}",
        "locationId": "steel-mill-north-test-track",
        "liveries": "LocoDE2",
        "roles": "Locomotive",
        "preventDerailment": "true",
        "protectFuses": "true",
        "preventDamage": "true",
        "sustainEngine": "true",
        "maximumSpeedKph": "80"
      },
      "capture": {
        "carNetId": "fixture.cars[0].netId",
        "trainNetIds": "fixture.netIds"
      }
    },
    {
      "id": "observe-train-client",
      "command": "train.fixture-observe",
      "target": "client",
      "parameters": {
        "fixtureId": "de2-cabin-lab-reentry-${run.id}",
        "netIds": "${var.trainNetIds}"
      }
    },
    {
      "id": "board-host",
      "command": "train.fixture-place-player",
      "target": "host",
      "parameters": {
        "carNetId": "${var.carNetId}",
        "anchor": "cab"
      },
      "assertions": [
        {
          "path": "insideResolvedCab",
          "equals": true
        }
      ]
    },
    {
      "id": "board-client",
      "command": "train.fixture-place-player",
      "target": "client",
      "parameters": {
        "carNetId": "${var.carNetId}",
        "anchor": "cab"
      },
      "assertions": [
        {
          "path": "insideResolvedCab",
          "equals": true
        }
      ]
    },
