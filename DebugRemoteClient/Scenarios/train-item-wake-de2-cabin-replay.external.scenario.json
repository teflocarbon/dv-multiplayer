{
  "testId": "external.train-item-wake-de2-cabin-replay",
  "displayName": "Replay captured DE2 cabin pile and launch box",
  "category": "Train Item Wake System",
  "fidelity": "CapturedTrainLocalLab+ProductionWakeLease+CollisionWitness",
  "timeoutMilliseconds": 240000,
  "requiredCapabilities": [
    "host-train-fixtures",
    "train-item-wake-lab",
    "inventory-runtime-arrangement"
  ],
  "sourceProfile": "../Labs/de2-cabin-box-stack.lab.json",
  "steps": [
    {
      "id": "create-train",
      "command": "train.fixture-create",
      "target": "host",
      "parameters": {
        "fixtureId": "de2-cabin-wake-lab-${run.id}",
        "locationId": "steel-mill-north-test-track",
        "liveries": "LocoDE2",
        "roles": "Locomotive",
        "preventDerailment": "true",
        "preventDamage": "true"
      },
      "capture": {
        "carNetId": "fixture.cars[0].netId",
        "trainNetIds": "fixture.netIds"
      }
    },
    {
      "id": "board-host",
      "command": "train.fixture-place-player",
      "target": "host",
      "parameters": {
        "carNetId": "${var.carNetId}",
        "anchor": "cab"
      }
    },
    {
      "id": "create-item-0",
      "command": "inventory.fixture-create",
      "target": "host",
      "parameters": {
        "prefabName": "PaperBox",
        "ownerPlayerId": "0",
        "placement": "world",
        "belongsToPlayer": "false"
      },
      "capture": {
        "item0NetId": "netId",
        "item0Token": "fixtureToken"
      }
    },
    {
      "id": "place-item-0",
      "command": "train.item-lab-arrange",
      "target": "host",
      "parameters": {
        "carNetId": "${var.carNetId}",
        "itemNetIds": "${var.item0NetId}",
        "layout": "line",
        "x": "0.8239417",
        "y": "1.54508185",
        "z": "-0.8714006",
        "rotationX": "-0.000451653585",
        "rotationY": "-0.8936615",
        "rotationZ": "-0.0004244284",
        "rotationW": "-0.4487411"
      },
      "assertions": [
        {
