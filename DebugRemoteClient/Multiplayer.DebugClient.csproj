<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <MultiplayerAssemblyPath Condition="'$(MultiplayerAssemblyPath)' == ''">..\Multiplayer\bin\Debug\net48\Multiplayer.dll</MultiplayerAssemblyPath>
    <ProtocolManifestPath Condition="'$(ProtocolManifestPath)' == ''">..\Multiplayer\bin\Debug\net48\protocol-manifest.json</ProtocolManifestPath>
    <DerailValleyManagedDir Condition="'$(DerailValleyManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Derail Valley\DerailValley_Data\Managed</DerailValleyManagedDir>
    <ReferencePath>$(DerailValleyManagedDir)\;$(DerailValleyManagedDir)\UnityModManager\;</ReferencePath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(ReferencePath);</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK's default glob is relative to Debug/, so explicitly exclude the independent
         transport-spike project (including its generated obj assembly attributes). -->
    <Compile Remove="TransportSpike\**\*.cs" />
    <None Update="WebUI\**\*" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Use the exact build artifact, not an older Multiplayer.dll copied into a previous debug output. -->
    <Reference Include="$(MultiplayerAssemblyPath)"><Private>true</Private></Reference>
    <None Include="$(ProtocolManifestPath)" Link="protocol-manifest.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(ProtocolManifestPath)')" />
    <Reference Include="UnityEngine"><HintPath>$(DerailValleyManagedDir)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(DerailValleyManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
