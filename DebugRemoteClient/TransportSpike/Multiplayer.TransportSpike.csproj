<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DerailValleyManagedDir Condition="'$(DerailValleyManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Derail Valley\DerailValley_Data\Managed</DerailValleyManagedDir>
    <DerailValleyPluginDir Condition="'$(DerailValleyPluginDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Derail Valley\DerailValley_Data\Plugins\x86_64</DerailValleyPluginDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>$(DerailValleyManagedDir)\Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DerailValleyManagedDir)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DerailValleyManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DerailValleyManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(DerailValleyManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Multiplayer\Networking\TransportLayers\ITransport.cs" Link="Source\ITransport.cs" />
    <Compile Include="..\..\Multiplayer\Networking\TransportLayers\SteamworksTransport.cs" Link="Source\SteamworksTransport.cs" />
    <Compile Include="..\..\Multiplayer\Networking\Data\ModInfo.cs" Link="Source\ModInfo.cs" />
    <Compile Include="..\..\Multiplayer\Networking\Packets\Serverbound\ServerboundClientLoginPacket.cs" Link="Source\ServerboundClientLoginPacket.cs" />
    <Compile Include="..\..\Multiplayer\Networking\Packets\Clientbound\ClientboundLoginResponsePacket.cs" Link="Source\ClientboundLoginResponsePacket.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(DerailValleyPluginDir)\steam_api64.dll" Link="steam_api64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
