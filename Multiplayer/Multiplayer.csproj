<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Multiplayer</RootNamespace>
        <!-- Versions are calendar dates, YYYY.M.D.N (docs/development.md). A Release build stamps
             today's date and the next build number for the day, one past the zips already in
             Releases/, and post-build.ps1 writes it into info.json. Any other build is a dev build,
             YYYY.M.D-dev.HHMM from its build time, and leaves info.json alone. The manifest pass
             reuses the first pass's version. -->
        <DvmpBuildNumberFile>$(MSBuildProjectDirectory)\..\build\dvmp-build-number.txt</DvmpBuildNumberFile>
        <DvmpBuildNumber Condition="'$(DvmpBuildNumber)' == '' AND '$(ManifestEmbedPass)' == 'true' AND Exists('$(DvmpBuildNumberFile)')">$([System.IO.File]::ReadAllText('$(DvmpBuildNumberFile)').Trim())</DvmpBuildNumber>
        <DvmpBuildNumber Condition="'$(DvmpBuildNumber)' == ''">$([System.DateTime]::Now.ToString('yyyy.MM.dd.HHmm'))</DvmpBuildNumber>
        <ReleasesDir>$(MSBuildProjectDirectory)\..\Releases</ReleasesDir>
        <ReleaseVersionFile>$(MSBuildProjectDirectory)\..\build\release-version.txt</ReleaseVersionFile>
        <ReleaseDate>$([System.DateTime]::Now.ToString('yyyy.M.d'))</ReleaseDate>
        <ReleaseBuildNumber Condition="Exists('$(ReleasesDir)')">$([MSBuild]::Add($([System.IO.Directory]::GetFiles('$(ReleasesDir)', 'Multiplayer $(ReleaseDate).*.zip').Length), 1))</ReleaseBuildNumber>
        <ReleaseBuildNumber Condition="'$(ReleaseBuildNumber)' == ''">1</ReleaseBuildNumber>
        <InformationalVersion Condition="'$(Configuration)' == 'Release' AND '$(ManifestEmbedPass)' == 'true' AND Exists('$(ReleaseVersionFile)')">$([System.IO.File]::ReadAllText('$(ReleaseVersionFile)').Trim())</InformationalVersion>
        <InformationalVersion Condition="'$(Configuration)' == 'Release' AND '$(InformationalVersion)' == ''">$(ReleaseDate).$(ReleaseBuildNumber)</InformationalVersion>
        <!-- From the build number (yyyy.MM.dd.HHmm), without the zero padding of month and day. -->
        <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(DvmpBuildNumber.Split('.')[0]).$([MSBuild]::Add($(DvmpBuildNumber.Split('.')[1]), 0)).$([MSBuild]::Add($(DvmpBuildNumber.Split('.')[2]), 0))-dev.$(DvmpBuildNumber.Split('.')[3])</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>DVMPBuildNumber</_Parameter1>
            <_Parameter2>$(DvmpBuildNumber)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="LiteNetLib" Version="1.3.1" />
        <Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.CharacterController" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.Interaction" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.RailTrack" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.TerrainSystem" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="WorldStreamer" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.Simulation" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.Platform.Steam" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.Utils:DV.Utils.SingletonBehaviour`1._instance" />
        <Publicize Include="DV.Utils:HingeJointAngleFix.angleOffset" />
        <Publicize Include="DV.Utils:HingeJointAngleFix.angleRange" />
        <Publicize Include="DV.Utils:HingeJointAngleFix.startRotationInverse" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.InventoryItemData" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.InventoryItems" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.EquippedItems" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.droppedItems" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.inventoryItemsExcludingDropped" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.lockedAndReservedMap" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.removeItemFromWorldCoros" />
        <Publicize Include="DV.Inventory:DV.InventorySystem.Inventory.FinalizeRemoveItemFromWorld" />
        <Publicize Include="DV.UI" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="DV.UIFramework" IncludeCompilerGeneratedMembers="false" />
        <Publicize Include="Facepunch.Steamworks.Win64" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>
    
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ProtocolManifestPath>$(IntermediateOutputPath)protocol-manifest.json</ProtocolManifestPath>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Tools\ProtocolManifestGenerator\ProtocolManifestGenerator.csproj" ReferenceOutputAssembly="false" />
        <!-- The dedicated server app, built first so post-build.ps1 can ship it with the mod. -->
        <ProjectReference Include="..\Tools\DedicatedHost\ServerApp\ServerApp.csproj" ReferenceOutputAssembly="false" />
        <EmbeddedResource Include="$(ProtocolManifestPath)" LogicalName="Multiplayer.ProtocolManifest.json" Condition="'$(ManifestEmbedPass)' == 'true' AND Exists('$(ProtocolManifestPath)')" />
    </ItemGroup>
    <!-- The GameNetworkingSockets transport is for test pairs without Steam (docs/testing.md, "GNS
         pairs") and exists in Debug builds only: a release must not run without Steam. Its DLL comes
         from DevTools/Gns/build-gns.ps1; post-build.ps1 installs it with a Debug build and refuses to
         package it. -->
    <PropertyGroup>
        <GnsDll Condition="'$(GnsDll)' == ''">$(LOCALAPPDATA)\dvmp\gns\1.6.1\GameNetworkingSockets.dll</GnsDll>
    </PropertyGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Remove="Shared\Transport\Gns\**" />
    </ItemGroup>
    <!-- The client/server split is a compile error to cross (docs/design/code-layout.md): the role
         analyzer fails the build on a reference across roles not in the allow-list (DVMP0001), or a
         file whose namespace isn't its folder's (DVMP0002). -->
    <ItemGroup>
        <ProjectReference Include="..\Tools\RoleAnalyzer\RoleAnalyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <AdditionalFiles Include="..\Multiplayer.Protocol.Tests\CodeLayout\role-references.allowed.txt" />
        <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    </ItemGroup>
    
    <!-- Derail Valley References -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp" />
        <Reference Include="CommandTerminal" />
        <Reference Include="DV.BrakeSystem" />
        <Reference Include="DV.BuildInfo" />
        <Reference Include="DV.CabControls.Spec" />
        <Reference Include="DV.CharacterController" />
        <Reference Include="DV.Common" />
        <Reference Include="DV.ControllerAnchors" />
        <Reference Include="DV.Highlighting" />
        <Reference Include="DV.Interaction" />
        <Reference Include="DV.Inventory" />
        <Reference Include="DV.Layers" />
        <Reference Include="DV.Localization" />
        <Reference Include="DV.NAudio" />
        <Reference Include="DV.PointSet" />
        <Reference Include="DV.RadioPlayer" />
        <Reference Include="DV.RailTrack" />
        <Reference Include="DV.Scenarios.CRUD" />
        <Reference Include="DV.Simulation" />
        <Reference Include="DV.Platform.Steam" />
        <Reference Include="DV.Telemetry" />
        <Reference Include="DV.TerrainSystem" />
        <Reference Include="DV.TerrainTools" />
        <Reference Include="DV.ThingTypes" />
        <Reference Include="DV.UI" />
        <Reference Include="DV.UIFramework" />
        <Reference Include="DV.UserManagement" />
        <Reference Include="DV.Utils" />
        <Reference Include="DV.WeatherSystem" />
    </ItemGroup>
    <!-- Mod Loader -->
    <ItemGroup>
        <PackageReference Include="UnityModManager" Version="0.31.1" />
    </ItemGroup>
    <!-- Third-Party References -->
    <ItemGroup>
        <PackageReference Include="ErrorProne.NET.Structs" Version="0.4.0-beta.1" />
        <Reference Include="Facepunch.Steamworks.Win64" />
        <PackageReference Include="Humanizer.Core" Version="2.14.1" />
        <ProjectReference Include="..\MultiplayerAPI\MultiplayerAPI.csproj" />
        <ProjectReference Include="..\Multiplayer.Core\Multiplayer.Core.csproj" />
        <ProjectReference Include="..\Multiplayer.DebugProtocol\Multiplayer.DebugProtocol.csproj" />
        <Reference Include="I2.Localization" />
        <Reference Include="MultiplayerEditor">
            <HintPath>../build/MultiplayerEditor.dll</HintPath>
        </Reference>
        <Reference Include="Microsoft.CSharp" />
        <Reference Include="net.smkd.vector3d" />
        <Reference Include="Newtonsoft.Json" />
        <Reference Include="RootMotion" />
        <Reference Include="Stateless" />
        <Reference Include="UniTask" />
        <Reference Include="UnityChan">
            <HintPath>../build/UnityChan.dll</HintPath>
        </Reference>
        <Reference Include="WorldStreamer" />
    </ItemGroup>
    <!-- Unity References -->
    <ItemGroup>
        <Reference Include="Unity.Collections" />
        <Reference Include="Unity.Mathematics" />
        <Reference Include="Unity.TextMeshPro" />
        <Reference Include="UnityEngine" />
        <Reference Include="UnityEngine.AssetBundleModule" />
        <Reference Include="UnityEngine.AudioModule" />
        <Reference Include="UnityEngine.AnimationModule" />
        <Reference Include="UnityEngine.CoreModule" />
        <Reference Include="UnityEngine.IMGUIModule" />
        <Reference Include="UnityEngine.JSONSerializeModule" />
        <Reference Include="UnityEngine.PhysicsModule" />
        <Reference Include="UnityEngine.TerrainModule" />
        <Reference Include="UnityEngine.TerrainPhysicsModule" />
        <Reference Include="UnityEngine.UI" />
        <Reference Include="UnityEngine.UIModule" />
        <Reference Include="UnityEngine.TextRenderingModule" />
        <Reference Include="UnityEngine.UnityWebRequestModule" />
        <Reference Include="UnityEngine.InputLegacyModule" />
        <Reference Include="VRTK" />
    </ItemGroup>
    <Target Name="PostBuildMacros">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets" />
        </GetAssemblyIdentity>
        <ItemGroup>
            <VersionNumber Include="$(InformationalVersion.Split('+')[0] )" />
        </ItemGroup>
    </Target>
    <Target Name="WriteDvmpBuildNumber" BeforeTargets="GenerateAssemblyInfo">
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(DvmpBuildNumberFile)'))" />
        <WriteLinesToFile File="$(DvmpBuildNumberFile)" Lines="$(DvmpBuildNumber)" Overwrite="true" />
        <!-- For the manifest pass, which would otherwise count this build's own zip. Without the
             +commit the SDK has added by now, or the manifest pass would add it a second time. -->
        <WriteLinesToFile Condition="'$(Configuration)' == 'Release' AND '$(ManifestEmbedPass)' != 'true'" File="$(ReleaseVersionFile)" Lines="$(InformationalVersion.Split('+')[0])" Overwrite="true" />
    </Target>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent" DependsOnTargets="PostBuildMacros">
        <!-- Sign Assemblies if in 'Release' -->
        <Exec Condition="$(ConfigurationName) == 'Release' AND $(Cert-Thumb) != ''" Command="&quot;$(SignToolPath)SignTool.exe&quot; sign /sha1 $(Cert-Thumb) /fd SHA256 /t http://timestamp.sectigo.com &quot;$(TargetPath)&quot; &quot;$(OutDir)/LiteNetLib.dll&quot;" />
        <!-- Copy to build folder -->
        <Copy SourceFiles="../info.json;../locale.csv;../LICENSE;$(TargetPath);$(OutDir)/Humanizer.dll;$(OutDir)/LiteNetLib.dll;$(OutDir)/Multiplayer.Core.dll;$(OutDir)/Multiplayer.DebugProtocol.dll" DestinationFolder="../build/" />
        <!-- Update Json, copy to game directory and make package if in 'Release' -->
        <!-- Windows: use powershell -->
        <Exec Condition="$(ConfigurationName) == 'Release' AND $([MSBuild]::IsOsPlatform('Windows'))" Command="powershell -executionpolicy bypass -Command &quot;(../post-build.ps1 -Ver '@(VersionNumber)' -Target '$(TargetPath)' -GameDir '$(DvInstallDir)\Mods\Multiplayer')&quot;" />
        <Exec Condition="$(ConfigurationName) == 'Debug' AND $([MSBuild]::IsOsPlatform('Windows'))" Command="powershell -executionpolicy bypass -Command &quot;(../post-build.ps1 -Ver '@(VersionNumber)' -NoArchive -Target '$(TargetPath)' -GameDir '$(DvInstallDir)\Mods\Multiplayer' -GnsDll '$(GnsDll)')&quot;" />
        <!-- Linux/macOS: use pwsh -->
        <Exec Condition="$(ConfigurationName) == 'Release' AND !$([MSBuild]::IsOsPlatform('Windows'))" Command="pwsh -ExecutionPolicy Bypass -Command &quot;(../post-build.ps1 -Ver '@(VersionNumber)' -Target '$(TargetPath)' -GameDir '$(DvInstallDir)/Mods/Multiplayer')&quot;" ContinueOnError="true" />
        <Exec Condition="$(ConfigurationName) == 'Debug' AND !$([MSBuild]::IsOsPlatform('Windows'))" Command="pwsh -ExecutionPolicy Bypass -Command &quot;(../post-build.ps1 -Ver '@(VersionNumber)' -NoArchive -Target '$(TargetPath)' -GameDir '$(DvInstallDir)/Mods/Multiplayer' -GnsDll '$(GnsDll)')&quot;" ContinueOnError="true" />
    </Target>
    <Target Name="GenerateProtocolManifest" AfterTargets="Build" Condition="'$(ManifestEmbedPass)' != 'true'">
        <Exec Command="&quot;$(MSBuildProjectDirectory)\..\Tools\ProtocolManifestGenerator\bin\$(Configuration)\net48\ProtocolManifestGenerator.exe&quot; &quot;$(TargetPath)&quot; &quot;$(DvInstallDir)\DerailValley_Data\Managed&quot; &quot;$(ProtocolManifestPath)&quot;" />
        <Copy SourceFiles="$(ProtocolManifestPath)" DestinationFolder="$(OutDir)" />
        <!-- The second pass is its own process: pass the install on, or it installs into the default
             one (Directory.Build.targets) even when this build was pointed elsewhere (-p:DvInstallDir). -->
        <Exec Command="dotnet build &quot;$(MSBuildProjectFullPath)&quot; --no-restore -p:ManifestEmbedPass=true -p:Configuration=$(Configuration) &quot;-p:DvInstallDir=$(DvInstallDir)&quot;" />
    </Target>
</Project>
