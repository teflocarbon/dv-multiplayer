<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <MultiplayerAssemblyPath Condition="'$(MultiplayerAssemblyPath)' == ''">..\Multiplayer\bin\Debug\net48\Multiplayer.dll</MultiplayerAssemblyPath>
    <DerailValleyManagedDir Condition="'$(DerailValleyManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Derail Valley\DerailValley_Data\Managed</DerailValleyManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <ProjectReference Include="..\Multiplayer.DebugProtocol\Multiplayer.DebugProtocol.csproj" />
    <Reference Include="Multiplayer"><HintPath>$(MultiplayerAssemblyPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(DerailValleyManagedDir)\Assembly-CSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(DerailValleyManagedDir)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(DerailValleyManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
